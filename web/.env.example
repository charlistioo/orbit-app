# Copy to .env.local for local dev, or set these as Environment
# Variables in Vercel's project settings for production. Both must
# start with NEXT_PUBLIC_ since they're read in the browser.

# The deployed backend's public URL, with /api/v1 appended.
# Example once deployed on Railway: https://orbit-backend.up.railway.app/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1

# The same Google OAuth Web Client ID the backend verifies against.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
