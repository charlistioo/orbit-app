# Copy to .env for local dev, or set these as environment variables in
# your hosting provider's dashboard for production.

# PostgreSQL connection string. Railway's Postgres plugin provides this
# automatically as DATABASE_URL - no need to set it by hand there.
DATABASE_URL=postgres://user:password@host:5432/orbit?sslmode=disable

# The same Google OAuth Web Client ID used by web/ - both the backend
# (to verify id_token) and the frontend (to render the Sign-In button)
# must reference the same client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signs ORBIT's own session JWTs. Generate a real random secret for
# production - never reuse the local dev value. Example:
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-value

# Optional - most hosts (Railway included) set this automatically.
# PORT=8080
